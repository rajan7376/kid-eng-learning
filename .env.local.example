# ---- 公司網路自簽憑證才需要(本機開發用) ----
# 若 server 端 fetch Supabase 出現 SELF_SIGNED_CERT_IN_CHAIN，打開這行
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service role key (server only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- 自建帳密驗證 ----
# JWT 簽章密鑰(請用長隨機字串，例如: openssl rand -base64 32)
AUTH_SECRET=please-change-to-a-long-random-secret
# 第一個管理員帳號(首次啟動自動建立)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# ---- Google Gemini ----
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR-GEMINI-KEY
# Model with multimodal + JSON mode (free tier eligible). e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ---- Azure Speech (Neural TTS) ----
# Azure Portal > Speech resource > Keys and Endpoint
AZURE_SPEECH_KEY=YOUR-AZURE-SPEECH-KEY
AZURE_SPEECH_REGION=eastasia
# Neural voice name (en-US-AvaNeural / en-US-JennyNeural ...)
AZURE_TTS_VOICE=en-US-AvaNeural
